generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  password       String
  userName       String?
  profilePicture String?
  rooms          Room[]
  chats          Chat[]
}

model Room {
  roomId  Int    @id @default(autoincrement())
  slug    String @unique
  adminId Int
  admin   User   @relation(references: [id], fields: [adminId])
  chats   Chat[]
}

model Chat {
  chatId  Int    @id @default(autoincrement())
  roomId  Int
  room    Room   @relation(references: [roomId], fields: [roomId])
  message String
  userId  Int
  user    User   @relation(references: [id], fields: [userId])
}
